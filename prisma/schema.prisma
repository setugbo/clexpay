generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  deleted
}

enum UserRole {
  user
  admin
  super_admin
}

enum TransactionType {
  deposit
  withdrawal
  transfer
  trade
  bill
  giftcard
}

enum TransactionStatus {
  pending
  success
  failed
  cancelled
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  phone        String?
  status        UserStatus @default(active)
  role        UserRole   @default(user)
  emailVerified Boolean   @default(false) @map("email_verified")
  otpCode       String?   @map("otp_code")
  otpExpiresAt  DateTime? @map("otp_expires_at")
  
  kycStatus    KycStatus  @default(not_started) @map("kyc_status")
  bvn         String?   @map("bvn")
  bvnVerifiedAt DateTime? @map("bvn_verified_at")
  idType      String?   @map("id_type")
  idNumber    String?   @map("id_number")
  idVerifiedAt DateTime? @map("id_verified_at")
  address     String?
  dob        String?
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  wallets       Wallet[]
  transactions  Transaction[]
  activityLogs  ActivityLog[]

  @@map("users")
}

enum KycStatus {
  not_started
  pending
  verified
  rejected
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  currency  String   // NGN, BTC, ETH, USDT
  balance   Decimal  @default(0) @db.Decimal(20, 8)
  isCrypto  Boolean  @default(false) @map("is_crypto")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  type        TransactionType
  subtype     String?
  currency    String?
  amount      Decimal           @db.Decimal(20, 8)
  fee         Decimal           @default(0) @db.Decimal(20, 8)
  status      TransactionStatus @default(pending)
  reference   String            @unique
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model RateLimit {
  id        String   @id @default(uuid())
  identifier String  // IP address or userId
  endpoint  String   // API route path
  windowStart DateTime @map("window_start")
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([identifier, endpoint, windowStart])
  @@index([identifier, endpoint, windowStart])
  @@map("rate_limits")
}

model ApiError {
  id           String   @id @default(uuid())
  endpoint     String   @map("endpoint")
  method       String   @map("method")
  errorCode    String?  @map("error_code")
  errorMessage String   @map("error_message")
  stackTrace   String?  @map("stack_trace")
  requestData  Json?    @map("request_data")
  statusCode   Int      @map("status_code")
  resolved     Boolean  @default(false) @map("resolved")
  resolvedBy   String?  @map("resolved_by")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([endpoint])
  @@index([statusCode])
  @@index([resolved])
  @@index([createdAt])
  @@map("api_errors")
}
